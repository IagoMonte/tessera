#!/usr/bin/env bash
# Sobe o ttyd de um projeto a partir de /etc/tty-orquestrador/projetos/<nome>.conf (DIR, USUARIO, PORTA).
#   tty-ttyd <projeto>
set -eu
UETC="${XDG_CONFIG_HOME:-${HOME:-/nao-definido}/.config}/tty-orquestrador"   # modo sem root: config no HOME do usuário
if [ -n "${TTY_ETC:-}" ]; then ETC=$TTY_ETC; elif [ -r "$UETC/conf" ]; then ETC=$UETC; else ETC=/etc/tty-orquestrador; fi
nome=${1:?uso: tty-ttyd <projeto>}
[[ "$nome" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$ ]] || { echo "projeto inválido" >&2; exit 2; }
. "$ETC/projetos/$nome.conf"
IFACE=${TTY_IFACE:-tailscale0}
# sem credencial o ttyd entregaria um shell a quem alcançar a porta: não sobe sem CRED.
# Gere com: tty-projeto add <nome> (mantém DIR/PORTA e cria o CRED que faltar).
[[ "${CRED:-}" =~ ^[0-9a-f]{32}$ ]] || { echo "tty-ttyd: $nome sem CRED no .conf; rode: tty-projeto add $nome" >&2; exit 1; }
# tema do Tessera (escuro); o painel aplica o tema ativo nos seus próprios terminais
tema='{"background":"#0f0f12","foreground":"#ececee","cursor":"#8ab4ff","selectionBackground":"#2a3550"}'
# ttyd 1.7.4 ignorou "-i <interface>" e escutou em 0.0.0.0: sem senha própria, isso é RCE.
# Por isso não confiamos no -i: depois de subir, confere o endereço de escuta e aborta se for curinga.
# -a mantido: o terminal vem de ?arg= (tty-sessao valida o nome com regex).
ttyd -W -O -a -c "tessera:$CRED" -i "$IFACE" -p "$PORTA" \
  -t titleFixed="$nome" -t fontSize=13 -t "fontFamily=Geist Mono, ui-monospace, monospace" -t "theme=$tema" \
  tty-sessao "$nome" "$DIR" &
pid=$!
trap 'kill "$pid" 2>/dev/null' TERM INT
for _ in $(seq 1 50); do
  kill -0 "$pid" 2>/dev/null || { wait "$pid"; exit $?; }
  escuta=$(ss -H -ltn "sport = :$PORTA" 2>/dev/null | awk '{print $4}')
  if grep -Eq '^(0\.0\.0\.0|\*|\[::\]):' <<<"$escuta"; then
    kill "$pid" 2>/dev/null
    echo "tty-ttyd: ttyd escutou em endereço curinga ($escuta) apesar de -i $IFACE; abortando" >&2
    exit 1
  fi
  [ -n "$escuta" ] && break
  sleep 0.1
done
[ -n "${escuta:-}" ] || { kill "$pid" 2>/dev/null; echo "tty-ttyd: ttyd não abriu a porta $PORTA" >&2; exit 1; }
wait "$pid"
